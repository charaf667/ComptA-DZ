{
  "name": "comptadz-api",
  "version": "0.1.0",
  "description": "Backend multi-tenant SaaS ComptaDZ (Node.js, TypeScript, Express, PostgreSQL)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "npm run test -- --watch",
    "db:reset": "prisma migrate reset --force --skip-seed && ts-node src/scripts/init-db-with-accounts.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write 'src/**/*.{ts,js}'",
    "test:mocha": "mocha --require ts-node/register"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@prisma/client": "^5.10.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "fs-extra": "^11.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "multer": "^2.0.0",
    "node-tesseract-ocr": "^2.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "prisma": "^5.10.2",
    "recharts": "^2.15.3",
    "sharp": "^0.32.6",
    "socket.io": "^4.8.1",
    "tesseract.js": "^4.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "chai": "^5.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29",
    "mocha": "^11.7.0",
    "prettier": "^3.6.0",
    "sinon": "^21.0.0",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "typescript": "^5.4.5"
  }
}
