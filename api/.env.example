# Exemple de configuration d'environnement pour ComptaDZ API

# Configuration Prisma (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/comptadz

# Configuration Mongoose (MongoDB)
MONGODB_URI=mongodb://localhost:27017/comptadz
USE_MONGOOSE=false

# Sécurité
JWT_SECRET=change_this_secret

# Serveur
PORT=4000
