# --- ComptaDZ Example Environment File ---
# Copiez ce fichier vers `.env` et ajustez les valeurs.

# Base de données Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comptadz_dev"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/comptadz_test"

# JWT
JWT_SECRET="change_me"
JWT_EXPIRES_IN="1h"

# Ports
PORT=4000

# Feature flags
FEATURE_AI=true
FEATURE_OCR=true
